# Copy to .env.local for local dev. In production set these in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
N8N_LEAD_WEBHOOK_URL=     # e.g. https://your-n8n.example.com/webhook/em-lead
N8N_SCORE_WEBHOOK_URL=    # optional: n8n scoring workflow used when a student picks the "n8n" engine; unset = always built-in
N8N_WEBHOOK_SECRET=       # shared secret sent as X-Webhook-Secret header
UPSTASH_REDIS_REST_URL=   # optional: enables cross-instance rate limit + extraction cache
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_HOUR=      # optional: new scorings per IP per hour (default 5, 0 = no limit)
NEXT_PUBLIC_SHOW_ENGINE_TOGGLE=   # optional: set to false to hide the reviewer Built-in | n8n switch (then always Built-in)
